    "./spec/ai-spec.md": "./spec/ai-spec.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asaday/nosrv.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/asaday/nosrv#readme",
  "bugs": {
    "url": "https://github.com/asaday/nosrv/issues"
