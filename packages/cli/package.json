{
  "name": "nosrv",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "CLI for developing, building, and deploying portable nosrv applications",
  "type": "module",
  "bin": {
    "nosrv": "bin/nosrv.js"
  },
  "files": [
    "bin",
    "dist",
    "spec"
  ],
  "exports": {
    "./bin/nosrv.js": "./bin/nosrv.js",
    "./spec/ai-spec.md": "./spec/ai-spec.md",
    "./runtime/filesystem": {
      "types": "./dist/filesystem.d.ts",
      "import": "./dist/filesystem.js"
    },
    "./runtime/memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./runtime/node": {
      "types": "./dist/runtime-node.d.ts",
      "import": "./dist/runtime-node.js"
    },
    "./runtime/sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./runtime/static-files": {
      "types": "./dist/static-files.d.ts",
      "import": "./dist/static-files.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asaday/nosrv.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/asaday/nosrv#readme",
  "bugs": {
    "url": "https://github.com/asaday/nosrv/issues"
  },
  "keywords": [
    "nosrv",
    "serverless",
    "faas",
    "cli",
    "portable"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nosrv/core": "0.2.0",
    "@nosrv/postgres": "0.2.0",
    "@nosrv/redis": "0.2.0",
    "croner": "^9.1.0",
    "esbuild": "^0.25.0",
    "tar": "^7.4.3",
    "tsx": "^4.20.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
