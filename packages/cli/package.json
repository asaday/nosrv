    "@nosrv/provider-gcs": "0.1.1",
    "@nosrv/provider-postgres": "0.1.1",
    "@nosrv/provider-redis": "0.1.1",
    "@nosrv/provider-s3": "0.1.1",
    "@nosrv/provider-memory": "0.1.1",
    "@nosrv/runtime-node": "0.1.1",
    "croner": "^9.1.0",
